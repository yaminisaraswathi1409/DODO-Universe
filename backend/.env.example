# Server Configuration
PORT=8080
ENV=development

# Database Configuration (Supabase PostgreSQL via standard pgx driver)
# Format: postgres://username:password@host:port/database_name?sslmode=require
DATABASE_URL=postgres://postgres.your-tenant:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth Configuration
# Used by Go backend middleware to validate Supabase-issued RS256 / HS256 JWT tokens
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Optional Cors Allowed Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
