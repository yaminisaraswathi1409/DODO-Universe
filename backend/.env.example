# ==============================================================================
# DODO UNIVERSE / UNIVERSAL OPPORTUNITY PLATFORM (UOP) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment: 'development' or 'production'
# In development:
#   - SMS_PROVIDER defaults to 'console' (prints OTP directly to server terminal)
#   - Ephemeral secrets are auto-generated if unset
#   - Localhost CORS allows all ports (Next.js, Flutter Web, etc.)
# In production:
#   - SMS_PROVIDER must be 'twilio' with valid credentials (or fails closed)
#   - All secrets and explicit CORS origins are strictly required
PORT=8080
ENV=development

# Database Configuration (Supabase PostgreSQL via pgx/v5 driver)
# Format: postgres://username:password@host:port/database_name?sslmode=require
DATABASE_URL=postgres://postgres.your-tenant:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth Configuration
# Used by Go backend middleware to validate Supabase-issued RS256 / HS256 JWT tokens 
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Authentication & Session Token Secrets (HS256)
# Optional in development (ephemeral secrets generated on startup). Required in production.
AUTH_JWT_SECRET=your-32-byte-hex-or-base64-jwt-secret
OTP_HMAC_SECRET=your-32-byte-hex-or-base64-otp-hmac-secret
FILE_SIGNING_SECRET=your-32-byte-hex-or-base64-file-signer-secret

# Token Lifetimes
AUTH_ACCESS_TOKEN_TTL=30m
AUTH_REFRESH_TOKEN_TTL=720h
OTP_TTL=5m

# SMS & OTP Gateway Configuration
# Options:
#   'console' - Development only. Prints the verification OTP to the backend terminal.
#   'twilio'  - Production SMS delivery via Twilio Programmable Messaging REST API.
#   'none'    - Fails closed (HTTP 503) when SMS is requested.
SMS_PROVIDER=console

# Twilio Credentials (Required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15005550006
# Optional: Use Messaging Service SID instead of From Number
# TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# CORS Allowed Origins (comma-separated)
# In development, localhost on any port (Next.js 3000, Flutter Web 5xxxx) is automatically allowed.
# In production, specify exact production domains (e.g., https://uop.platform,https://admin.uop.platform)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Private Upload Storage Directory
PRIVATE_UPLOAD_DIR=./private_uploads
